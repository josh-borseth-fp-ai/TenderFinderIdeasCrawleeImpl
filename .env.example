# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model slug, e.g. openai/gpt-4o-mini, anthropic/claude-sonnet-4
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: override the API base URL (proxy or local mock); default https://openrouter.ai/api/v1
OPENROUTER_API_URL=
# Optional: shown on your OpenRouter usage dashboard
OPENROUTER_SITE_URL=
OPENROUTER_SITE_TITLE=

# Source onboarding: build the local runtime with bun run runner:build.
# Durable SQLite database, captured fixtures, packages, and results:
# SCRAPER_DATA_DIR=.data/onboarding
# SCRAPER_RUNNER_IMAGE=bid-desk-runner:1
# SCRAPER_RUNTIME_DIR=/absolute/path/to/repository/runner
# SCRAPER_MIGRATIONS_DIR=/absolute/path/to/repository/drizzle
# Dockerode uses Docker Desktop / standard sockets, or an explicit DOCKER_HOST.
# DOCKER_HOST=unix:///path/to/docker.sock
# Production defaults to loopback. Use an authenticated reverse proxy for remote use.
# HOST=127.0.0.1
# SCRAPER_APP_ORIGIN=https://your-internal-host.example
