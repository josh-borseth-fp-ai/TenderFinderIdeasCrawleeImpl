{
  "name": "bid-desk-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape:example": "bun run scripts/scrape-example.ts",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "start": "bun run server.ts",
    "dev:mock": "OPENROUTER_API_KEY=sk-or-mock OPENROUTER_API_URL=http://localhost:4010 OPENROUTER_MODEL=mock/model vite dev --port 3000",
    "mock": "bun run scripts/mock-openrouter.ts",
    "typecheck": "tsc --noEmit",
    "lint:effect": "effect-tsgo diagnostics --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "effect-tsgo patch",
    "ui:add": "bunx --bun shadcn@latest add"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@crawlee/memory-storage": "3.18.1",
    "@effect/ai-openrouter": "4.0.0-rc.113",
    "@effect/atom-react": "4.0.0-rc.113",
    "@effect/platform-browser": "4.0.0-rc.113",
    "@fontsource-variable/geist": "^5.3.0",
    "@streamdown/code": "latest",
    "@tanstack/react-router": "1.170.34",
    "@tanstack/react-start": "1.168.51",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "crawlee": "3.18.1",
    "effect": "4.0.0-rc.113",
    "ipaddr.js": "2.3.0",
    "lucide-react": "^1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "streamdown": "2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@effect/vitest": "4.0.0-rc.113",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
